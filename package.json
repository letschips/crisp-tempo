{
  "name": "crisp-tempo",
  "version": "0.1.2",
  "description": "Things 3 × Linear independent personal task manager for Obsidian.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "test": "node --test tests/license.test.mjs",
    "test:e2e": "node tests/e2e/app.e2e.mjs",
    "deploy": "node scripts/deploy.mjs",
    "check": "npm run build && npm test && npm run test:e2e"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "todo",
    "linear",
    "things3",
    "gtd",
    "crisp"
  ],
  "author": "letschips",
  "license": "SEE LICENSE IN LICENSE",
  "dependencies": {
    "preact": "^10.25.4"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "builtin-modules": "^5.3.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.13.1",
    "playwright-core": "1.63.0",
    "typescript": "^5.7.3"
  },
  "private": true
}
